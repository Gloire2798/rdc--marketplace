generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// UTILISATEURS (acheteurs, vendeurs, admin)
model User {
  id           String    @id @default(cuid())
  telephone    String    @unique
  nom          String?
  email        String?   @unique
  motDePasse     String?
  role         String    @default("ACHETEUR") // ACHETEUR | VENDEUR | ADMIN
  createdAt    DateTime  @default(now())
  vendeur      Vendeur?
  commandes    Commande[]
}

// VENDEURS / BOUTIQUES
model Vendeur {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  nomBoutique     String
  description     String?
  logo            String?
  adresse           String?
  telephone       String
  numMobileMoney  String
  actif           Boolean   @default(true)
  commission      Float     @default(5.0)
  createdAt       DateTime  @default(now())
  produits        Produit[]
  commandes       Commande[]
}

// PRODUITS
model Produit {
  id          String   @id @default(cuid())
  vendeurId   String
  vendeur     Vendeur  @relation(fields: [vendeurId], references: [id])
  nom         String
  description String?
  prix        Float
  stock       Int      @default(0)
  photo       String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  items       CommandeItem[]
}

// COMMANDES
model Commande {
  id              String    @id @default(cuid())
  acheteurId      String
  acheteur        User      @relation(fields: [acheteurId], references: [id])
  vendeurId       String
  vendeur         Vendeur   @relation(fields: [vendeurId], references: [id])
  total           Float
  fraisLivraison  Float     @default(0)
  mode            String    // LIVRAISON | RETRAIT
  adresse         String?
  statut          String    @default("EN_ATTENTE") 
  // EN_ATTENTE | PAYE | PRET | RETIRE | ANNULE
  methodePaiement String    // MOBILE_MONEY | CASH_LIVRAISON
  qrToken         String    @unique @default(cuid())
  qrExpireAt      DateTime?
  retireAt        DateTime?
  createdAt       DateTime  @default(now())
  items           CommandeItem[]
  paiement        Paiement?
  scans           QrScan[]
}

// LIGNES DE COMMANDE
model CommandeItem {
  id           String   @id @default(cuid())
  commandeId   String
  commande     Commande @relation(fields: [commandeId], references: [id])
  produitId    String
  produit      Produit  @relation(fields: [produitId], references: [id])
  quantite     Int
  prixUnitaire Float
}

// PAIEMENTS
model Paiement {
  id                 String   @id @default(cuid())
  commandeId         String   @unique
  commande           Commande @relation(fields: [commandeId], references: [id])
  montant            Float
  methode            String   // MOBILE_MONEY | CASH
  operateur          String?  // ORANGE | AIRTEL | VODACOM
  refTransaction     String?
  statut             String   @default("EN_ATTENTE") 
  // EN_ATTENTE | CONFIRME | ECHOUE
  montantCommission  Float    @default(0)
  montantVendeur     Float    @default(0)
  createdAt          DateTime @default(now())
}

// SCANS DU QR (traçabilité)
model QrScan {
  id          String   @id @default(cuid())
  commandeId  String
  commande    Commande @relation(fields: [commandeId], references: [id])
  vendeurId   String
  resultat    String   // OK | REFUSE | DEJA_UTILISE
  scanAt      DateTime @default(now())
}
