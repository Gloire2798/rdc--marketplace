generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// UTILISATEURS
model User {
  id             String         @id @default(cuid())
  telephone      String         @unique
  nom            String?
  email          String?        @unique
  motDePasse     String?
  role           String         @default("ACHETEUR")
  createdAt      DateTime       @default(now())
  vendeur        Vendeur?
  commandes      Commande[]
  notifications  Notification[]
  abonnements    Abonnement[]
  tokensReset    TokenReset[]
}

// VENDEURS / BOUTIQUES
model Vendeur {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  nomBoutique        String
  description        String?
  logo               String?
  photoCouverture    String?
  photo2             String?
  photo3             String?
  adresse            String?
  telephone          String
  numMobileMoney     String
  numMpesa           String?
  numOrange          String?
  numAirtel          String?
  note               Float              @default(0)
  nombreAvis         Int                @default(0)
  actif              Boolean            @default(true)
  commission         Float              @default(5.0)
  jourEcheance       Int                @default(5)
  prochaineEcheance  DateTime?
  createdAt          DateTime           @default(now())
  produits           Produit[]
  commandes          Commande[]
  stories            Story[]
  paiementsFinance   PaiementFinance[]
  abonnes            Abonnement[]
}

// PRODUITS
model Produit {
  id          String   @id @default(cuid())
  vendeurId   String
  vendeur     Vendeur  @relation(fields: [vendeurId], references: [id])
  nom         String
  description String?
  prix        Float
  prixPromo   Float?
  devise      String   @default("FC")
  stock       Int      @default(0)
  photo1      String?
  photo2      String?
  photo3      String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  items       CommandeItem[]
  variantes   Variante[]

  @@index([vendeurId])
  @@index([actif])
}

// VARIANTES
model Variante {
  id          String   @id @default(cuid())
  produitId   String
  produit     Produit  @relation(fields: [produitId], references: [id], onDelete: Cascade)
  attributs   String
  stock       Int      @default(0)
  prix        Float?
  prixPromo   Float?
  createdAt   DateTime @default(now())

  @@index([produitId])
}

// STORIES
model Story {
  id        String   @id @default(cuid())
  vendeurId String
  vendeur   Vendeur  @relation(fields: [vendeurId], references: [id])
  photo     String
  legende   String?
  expireAt  DateTime
  createdAt DateTime @default(now())
}

// COMMANDES
model Commande {
  id              String        @id @default(cuid())
  groupeId        String?
  acheteurId      String?
  acheteur        User?         @relation(fields: [acheteurId], references: [id])
  nomClient       String?
  telephoneClient String?
  vendeurId       String
  vendeur         Vendeur       @relation(fields: [vendeurId], references: [id])
  total           Float
  fraisLivraison  Float         @default(0)
  mode            String
  adresse         String?
  statut          String        @default("EN_ATTENTE")
  methodePaiement String
  qrToken         String        @unique @default(cuid())
  qrExpireAt      DateTime?
  retireAt        DateTime?
  createdAt       DateTime      @default(now())
  items           CommandeItem[]
  paiement        Paiement?
  scans           QrScan[]

  @@index([groupeId])
}

// LIGNES DE COMMANDE
model CommandeItem {
  id           String   @id @default(cuid())
  commandeId   String
  commande     Commande @relation(fields: [commandeId], references: [id])
  produitId    String
  produit      Produit  @relation(fields: [produitId], references: [id])
  quantite     Int
  prixUnitaire Float
  varianteInfo String?
}

// PAIEMENTS
model Paiement {
  id                String   @id @default(cuid())
  commandeId        String   @unique
  commande          Commande @relation(fields: [commandeId], references: [id])
  montant           Float
  methode           String
  operateur         String?
  refTransaction    String?
  statut            String   @default("EN_ATTENTE")
  montantCommission Float    @default(0)
  montantVendeur    Float    @default(0)
  createdAt         DateTime @default(now())
}

// SCANS QR
model QrScan {
  id          String   @id @default(cuid())
  commandeId  String
  commande    Commande @relation(fields: [commandeId], references: [id])
  vendeurId   String
  resultat    String
  scanAt      DateTime @default(now())
}

// FINANCES
model PaiementFinance {
  id           String   @id @default(cuid())
  vendeurId    String
  vendeur      Vendeur  @relation(fields: [vendeurId], references: [id])
  type         String
  periode      String
  montant      Float
  statut       String   @default("IMPAYE")
  datePaiement DateTime?
  createdAt    DateTime @default(now())

  @@unique([vendeurId, type, periode])
  @@index([vendeurId])
  @@index([type])
  @@index([statut])
}

// PARAMÈTRES
model Parametre {
  id                String   @id @default("singleton")
  nomComplexe       String   @default("GK Sensei")
  adresse           String?
  telephone         String?
  fraisInscription  Int      @default(25000)
  loyerMensuel      Int      @default(15000)
  jourEcheance      Int      @default(15)
  numMobileMoney    String?
  lienAnalytics     String?
  updatedAt         DateTime @updatedAt
}

// NOTIFICATIONS
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  titre     String
  message   String
  lien      String?
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, lu])
  @@index([createdAt])
}

// ABONNEMENTS
model Abonnement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendeurId String
  vendeur   Vendeur  @relation(fields: [vendeurId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vendeurId])
  @@index([userId])
  @@index([vendeurId])
}

// TOKENS RESET MDP
model TokenReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expireAt  DateTime
  utilise   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([code])
  @@index([expireAt])
}

// LOGS SÉCURITÉ
model LogSecurite {
  id        String   @id @default(cuid())
  type      String
  niveau    String   @default("INFO")
  message   String
  details   String?
  userId    String?
  telephone String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([niveau])
  @@index([userId])
  @@index([ip])
  @@index([createdAt])
}

// RATE LIMITING
model Tentative {
  id          String   @id @default(cuid())
  ip          String?
  identifiant String?
  route       String
  count       Int      @default(1)
  expireAt    DateTime
  createdAt   DateTime @default(now())

  @@index([ip, route])
  @@index([identifiant, route])
  @@index([expireAt])
}
