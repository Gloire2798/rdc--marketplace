generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// UTILISATEURS
model User {
  id           String    @id @default(cuid())
  telephone    String    @unique
  nom          String?
  email        String?   @unique
  motDePasse   String?
  role         String    @default("ACHETEUR")
  createdAt    DateTime  @default(now())
  vendeur      Vendeur?
  commandes    Commande[]
}

// VENDEURS / BOUTIQUES
model Vendeur {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  nomBoutique     String
  description     String?
  logo            String?
  photoCouverture String?
  photo2          String?
  photo3          String?
  adresse         String?
  telephone       String
  numMobileMoney  String
  numMpesa        String?
  numOrange       String?
  numAirtel       String?
  note            Float     @default(0)
  nombreAvis      Int       @default(0)
  actif           Boolean   @default(true)
  commission      Float     @default(5.0)
  createdAt       DateTime  @default(now())
  produits        Produit[]
  commandes       Commande[]
  stories         Story[]
}

// PRODUITS
model Produit {
  id          String   @id @default(cuid())
  vendeurId   String
  vendeur     Vendeur  @relation(fields: [vendeurId], references: [id])
  nom         String
  description String?
  prix        Float
  prixPromo   Float?
  devise      String   @default("FC")
  stock       Int      @default(0)
  photo1      String?
  photo2      String?
  photo3      String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  items       CommandeItem[]
}

// STORIES (expirent après 24h)
model Story {
  id          String   @id @default(cuid())
  vendeurId   String
  vendeur     Vendeur  @relation(fields: [vendeurId], references: [id])
  photo       String
  legende     String?
  expireAt    DateTime
  createdAt   DateTime @default(now())
}

// COMMANDES
model Commande {
  id                String    @id @default(cuid())
  acheteurId        String?
  acheteur          User?     @relation(fields: [acheteurId], references: [id])
  nomClient         String?
  telephoneClient   String?
  vendeurId         String
  vendeur           Vendeur   @relation(fields: [vendeurId], references: [id])
  total             Float
  fraisLivraison    Float     @default(0)
  mode              String
  adresse           String?
  statut            String    @default("EN_ATTENTE")
  methodePaiement   String
  qrToken           String    @unique @default(cuid())
  qrExpireAt        DateTime?
  retireAt          DateTime?
  createdAt         DateTime  @default(now())
  items             CommandeItem[]
  paiement          Paiement?
  scans             QrScan[]
}

// LIGNES DE COMMANDE
model CommandeItem {
  id           String   @id @default(cuid())
  commandeId   String
  commande     Commande @relation(fields: [commandeId], references: [id])
  produitId    String
  produit      Produit  @relation(fields: [produitId], references: [id])
  quantite     Int
  prixUnitaire Float
}

// PAIEMENTS
model Paiement {
  id                 String   @id @default(cuid())
  commandeId         String   @unique
  commande           Commande @relation(fields: [commandeId], references: [id])
  montant            Float
  methode            String
  operateur          String?
  refTransaction     String?
  statut             String   @default("EN_ATTENTE")
  montantCommission  Float    @default(0)
  montantVendeur     Float    @default(0)
  createdAt          DateTime @default(now())
}

// SCANS DU QR
model QrScan {
  id          String   @id @default(cuid())
  commandeId  String
  commande    Commande @relation(fields: [commandeId], references: [id])
  vendeurId   String
  resultat    String
  scanAt      DateTime @default(now())
}
